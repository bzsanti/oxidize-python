class ReadOutlineDestination:
    """Internal destination resolved to a zero-based page index.

    Parameters: XYZ(left,top,zoom), FitR(left,bottom,right,top), FitH/FitBH(top),
    FitV/FitBV(left), Fit/FitB(). PDF null stays None. Non-GoTo actions have no
    destination; original action dictionaries/named aliases are not retained.
    """
    @property
    def page_index(self) -> int: ...
    @property
    def kind(self) -> Literal['XYZ', 'Fit', 'FitH', 'FitV', 'FitR', 'FitB', 'FitBH', 'FitBV']: ...
    @property
    def parameters(self) -> list[float | None]: ...

