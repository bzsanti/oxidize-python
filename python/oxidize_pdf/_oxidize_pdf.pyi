class OutlineReadOptions:
    """Read traversal budgets, not a total-memory cap. Zero is permitted.

    max_depth applies to outline, name-tree and destination traversal; root outline
    depth is zero. No outlines returns None; an existing empty tree has items=[].
    Malformed trees and exceeded budgets raise PdfParseError, not partial results.
    """
    def __init__(self, *, max_items: int = 100000, max_depth: int = 256,
                 max_named_destinations: int = 100000, max_name_tree_nodes: int = 100000) -> None: ...
    @property
    def max_items(self) -> int: ...
    @property
    def max_depth(self) -> int: ...
    @property
    def max_named_destinations(self) -> int: ...
    @property
    def max_name_tree_nodes(self) -> int: ...

