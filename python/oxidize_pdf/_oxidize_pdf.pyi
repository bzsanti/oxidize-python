    default pipeline (no overrides) reproduces ``PdfReader.rag_chunks`` exactly.
    """

    def __init__(self) -> None: ...

    def with_chunking(self, strategy: Any) -> "AnalysisPipeline":
        """Replace the chunking strategy.

        ``strategy`` must expose
        ``chunk(self, elements: list[Element]) -> list[ChunkGroup]``.
        """
        ...
    def with_max_tokens(self, max_tokens: int) -> "AnalysisPipeline":
        """Set the token budget used to flag oversized chunks."""
        ...
    def with_classifier(self, classifier: Any) -> "AnalysisPipeline":
        """Register a classifier that labels elements before chunking.

        ``classifier`` must expose
        ``classify(self, element: Element, ctx: ClassifyContext) -> ClassLabel | None``.
        """
        ...
    def with_enricher(self, enricher: Any) -> "AnalysisPipeline":
        """Register an enricher that writes provider-specific fields into each
        chunk's ``extra`` bag after metadata is derived.

        ``enricher`` must expose
        ``enrich(self, ctx: EnrichContext, extra: dict[str, Any]) -> None``.
        """
        ...
    def with_source(self, source: DocumentSource) -> "AnalysisPipeline":
        """Stamp source-document metadata on every chunk produced."""
        ...

    def __repr__(self) -> str: ...

# ── Batch processing (F62) ───────────────────────────────────────────────────

class BatchOptions:
    """Batch options (immutable). Memory is bytes; durations are positive seconds.

    Defaults: parallelism=min(CPU count, 8), stop_on_error=False, memory=0 (no cap),
    progress_interval=0.1, callback=None, job_timeout=300. None disables timeout.
    Core 5.5.0 rejects nonzero memory caps; timeouts report failure after completion without interruption.
    Callbacks receive owned ProgressInfo snapshots on native execution threads;
    they must return promptly. Empty batches do not call back. The first callback
    exception is re-raised by execute AFTER jobs finish; outputs may already exist.
    stop_on_error cancels jobs not yet dispatched, not work already queued.
    """

    def __init__(
        self,
        parallelism: Optional[int] = ...,
        stop_on_error: Optional[bool] = ...,
        *,
        memory_limit_per_worker: int = 0,
        progress_interval: float = 0.1,
        progress_callback: Optional[Callable[[ProgressInfo], None]] = None,
        job_timeout: Optional[float] = 300.0,
    ) -> None: ...
    @property
    def parallelism(self) -> int: ...
    @property
    def stop_on_error(self) -> bool: ...
    @property
    def memory_limit_per_worker(self) -> int: ...
    @property
    def progress_interval(self) -> float: ...
    @property
    def progress_callback(self) -> Optional[Callable[[ProgressInfo], None]]: ...
    @property
    def job_timeout(self) -> Optional[float]: ...
    def __repr__(self) -> str: ...

class BatchJob:
    """A single queued batch operation. Construct via the static factories."""

    @staticmethod
    def split(input: str, output_pattern: str, pages_per_file: int) -> BatchJob: ...
    @staticmethod
    def merge(inputs: list[str], output: str) -> BatchJob: ...
    @staticmethod
    def rotate(
        input: str, output: str, rotation: int, pages: Optional[list[int]]
    ) -> BatchJob: ...
    @staticmethod
    def extract(input: str, output: str, pages: list[int]) -> BatchJob: ...
    @staticmethod
    def compress(input: str, output: str, quality: int) -> BatchJob: ...
    def __repr__(self) -> str: ...

